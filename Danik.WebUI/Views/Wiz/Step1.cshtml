@using Type = Danik.WebUI.Code.Domain.Type
@model Danik.WebUI.Code.Domain.Order
@{
    ViewData["Title"] = "Home page";
    var isNew = Model.PersonInfos==null || Model.PersonInfos.Length == 0;
}
<style>
    .stone{  border-radius: 10px 10px 0 0; cursor: pointer; }
</style>

@using (Html.BeginForm("Step1", "Wiz", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <input type="hidden" name="id" value="@Model.Id"/>
    <div class="row">
        <div class="col-xxl-5 col-xl-6 col-lg-8 col-md-10">

            <h4 class="">1. Число усопших</h4>

            <div class="row mt-3">
                <div class="col-4 text-center">
                    <label style="cursor: pointer;">
                        <input name="count" @(Model.Persons==1?"checked":"") type="radio" value="1" onchange="ColChange(1)"/> <i class="fa fa-user fs-3"></i>
                        
                    </label>
                </div>
                <div class="col-4  text-center">
                    <label style="cursor: pointer;">
                        <input name="count" type="radio"  @(Model.Persons==2?"checked":"")  value="2" onchange="ColChange(2)" /> <i class="fa fa-user fs-3"></i> <i class="fa fa-user  fs-3"></i>
                        
                    </label>
                </div>
                <div class="col-4 text-center">
                    <label style="cursor: pointer;">
                        <input name="count" type="radio"  @(Model.Persons==3?"checked":"")  value="3" onchange="ColChange(3)" /> <i class="fa fa-user fs-3"></i> <i class="fa fa-user fs-3"></i> <i class="fa fa-user fs-3"></i>
                        
                    </label>
                </div>
            </div>

            <h4 class="mt-4">2. Ориентация</h4>

            <div class="row">
                <div class="col-4 text-center  mt-2">
                    <div><img onclick="$('#o1').click()" id="img1" src="/img/v1.png" class="stone" style="width: 100%;" /></div>
                    <div class="mt-2"><label><input type="radio" name="type" onchange="SetVert(true)" id="o1" @(Model.Type==Type.Вертикальный ? "checked":"") value="0" /> Верт</label></div>
                </div>
                <div class="col-4 text-center  mt-2">
                    <div><img onclick="$('#o2').click()" id="img2" src="/img/h1.png" class="stone" style="width:100%;" /></div>
                    <div class="mt-2"><label><input type="radio" name="type"  @(Model.Type==Type.Горизонтальный ? "checked":"") onchange="SetVert(false)" id="o2" value="1" /> Горизон</label></div>
                </div>
                <div class="col-4 text-center  mt-2" style="display: none;" id="pSplit">
                    <div><img onclick="$('#o3').click()" id="img3" src="/img/split2.png" class="stone" style="width: 100%; " /></div>
                    <div class="mt-2"><label><input type="radio" name="type" onchange="SetVert(true)"  @(Model.Type==Type.Сплит ? "checked":"") id="o3" value="2" /> Сплит</label></div>
                </div>
            </div>


            <h4 class="mt-4">3. Размер</h4>

            <div class="row sizeOption">
                <div class="col-4 text-center d-flex align-items-end" id="pSize40">
                    <div>
                        <img onclick="$('#s1').click()" id="img1" src="/img/v1.png" class="stone" style="width: 70%;"/>
                        <div class="mt-2"><label><input type="radio" name="ddlSize" id="s1" @(Model.Options.Size == 40 ? "checked" : "") value="0" /> <span id="sSize1">40 x 80</span></label></div>
                    </div>
                    
                </div>
                <div class="col-4 text-center d-flex align-items-end">
                    <div>
                        <img onclick="$('#s2').click()" id="img2" src="/img/v1.png" class="stone" style="width: 85%;"/>
                        <div class="mt-2"><label><input type="radio" name="ddlSize" @(Model.Options.Size == 60 ? "checked" : "")  id="s2" value="1" /> <span id="sSize2">50 x 100</span></label></div>
                    </div>
                    
                </div>
                <div class="col-4 text-center d-flex align-items-end">
                    <div>
                        <img onclick="$('#s3').click()" id="img3" src="/img/v1.png" class="stone" style="width: 100%;"/>
                        <div class="mt-2"><label><input type="radio" name="ddlSize" @(Model.Options.Size == 80 ? "checked" : "") id="s3" value="2" /> <span id="sSize3">60 x 120</span></label></div>
                    </div>
                    
                </div>
            </div>


            
            <h4 class="mt-3">4. Фото </h4>
            @if (!isNew)
            {
                <div>Не выбирайте фото если хотите оставить уже загруженные фотографии</div>
            }
            <div class="row">
                <div class="col-6" id="f1">Фото №1<input type="file" name="file" @(isNew ? "required":"") class="form-control" /></div>
                <div class="col-6" @(isNew ? "required":"") style="display: none;" id="f2">Фото №2<input type="file" name="file" class="form-control" /></div>
                <div class="col-6" @(isNew ? "required":"") style="display: none;" id="f3">Фото №3<input type="file" name="file" class="form-control" /></div>
            </div>
            <div class="mt-3"><a id="lh1" href="javascript:$('#lh1').hide();$('#h1').show(200);">Советы по пересьёмке фото на телефон</a></div>
            <div class="alert alert-success mt-3" id="h1" style="display: none;">
                <ol>


                    <li>Очисти линзу камеры – даже маленькие отпечатки или пыль сделают фото мутным.</li>

                    <li>Выбери ровную поверхность – положи фото на стол или прикрепи к стене, чтобы избежать изгибов.</li>

                    <li> Обеспечь равномерное освещение – лучше всего мягкий рассеянный свет (у окна днём или лампа с матовым абажуром).</li>
                </ol>
                💡 Освещение
                <ol>
                    <li>Избегай бликов и отражений – если появляется «белое пятно», измени угол наклона телефона или перемести источник света.</li>

                    <li>Не используй вспышку – она почти всегда даёт блики и искажает цвет.</li>
                </ol>
                📸 Съёмка
                <ol>
                    <li>Держи телефон параллельно фото – чтобы избежать перспективных искажений.</li>

                    <li>Включи сетку в камере – линии помогут выровнять кадр.</li>

                    <li>Используй режим HDR – он поможет сохранить детали в светлых и тёмных участках.</li>

                    <li>Делай несколько дублей – выбирай лучший позже.</li>
                </ol>
            </div>

        <div class="mt-4">
            <input type="submit" class="btn btn-primary" value="Дальше"/>
        </div>
        </div>
    </div>

}
@section Scripts
{
    <script>

        function ColChange(count) {
            document.getElementById('img1').src="/img/v" + count + ".png";
            document.getElementById('img2').src="/img/h" + count + ".png";
            document.getElementById('img3').src="/img/split" + count + ".png";
            if (count > 1) {
                document.getElementById('pSplit').style.display = 'block';
            } else {
                document.getElementById('pSplit').style.display = 'none';
            }
            if (count > 1) {
                $('#s2').click();
                document.getElementById('pSize40').style.visibility = "hidden";
            } else {
                document.getElementById('pSize40').style.visibility = "visible";
            }
            for (var i = 1; i < 4; i++) {
                if (i <= count) {
                    $('#f' + i).show();
                } else {
                    $('#f' + i).hide();
                }
            }
        }

        function SetVert(isVert) {
            document.getElementById('sSize1').innerHTML=isVert ? "40 x 80" : "80 x 40";
            document.getElementById('sSize2').innerHTML=isVert ? "50 x 100" : "100 x 50";
            document.getElementById('sSize3').innerHTML=isVert ? "60 x 120" : "120 x 60";
            $(".sizeOption img").attr("src",isVert ? "/img/v1.png" : "/img/h1.png");
        }

        ColChange(@Model.Persons);
        SetVert(@(Model.Type == Type.Вертикальный || Model.Type == Type.Сплит ? "true" : "false"));
    </script>
}
