@using Danik.WebUI.Code.ORM
@model Danik.WebUI.Code.Domain.Order
@{
    ViewData["Title"] = "Home page";
}

<style>
    .Portrait { width: 100%; filter: grayscale(100%);}
    .Layer {
        transform: translate(-50%,-50%);
        position: absolute;
        color: #fff;
    }
</style>
<div class="row mt-4">
    <div class="col-lg-8 mb-2">
        <div id="pMain">
            
        </div>
    </div>

    <div class="col-lg-4">
      <div id="pEditorPersons">

        </div>
        <div class="row mt-4">
            <div class="col-4"><a class="btn btn-secondary  w-100" href="/Wiz/Step1/@Model.Id">Назад</a></div>
            <div class="col-8"><a class="btn btn-primary w-100" href="javascript:Save()">Продолжить</a></div>
            
        </div>
    </div>

</div>



@section Scripts
{
    <script>
        var template = @Html.Raw(Model.TemplateData.ToJsonMin());
        var orderId = '@Html.Raw(Model.Id)';

        $(document).ready(function() {
            Init();
        });

        function Save() {
            // save template to server to /Wiz/Step4Save
            
            $.ajax({
                type: "POST",
                url: "/Wiz/Step4Save",
                data: { id: orderId, json: JSON.stringify(template) },
                success: function(response) {
                    window.location = "/Wiz/Step5/" + orderId;
                },
                error: function(xhr, status, error) {
                    alert("Ошибка сохранения данных");
                }
            });
            
        }

        function Init() {
            px = document.getElementById("pMain").clientWidth / 1000;
            DrawEditor();
            Draw(template);
        }

// COMMON CODE
        var px = 0;

        function DrawEditor() {
            var html = "";
            for (var i = 0; i < template.PersonInfos.length; i++) {
                var pi = template.PersonInfos[i];
                html += "<div class='mb-2' id='person" + i + "'>";
                html += "<div class='mt-1'>Фамилия<input type='text' id='p" + i + "f' class='pi form-control' value='" + pi.F + "'/></div>";
                html += "<div class='mt-1'>Имя<input type='text' id='p" + i + "i' class='pi form-control' value='" + pi.I + "'/></div>";
                html += "<div class='mt-1'>Отчество<input type='text' id='p" + i + "o' class='pi form-control' value='" + pi.O + "'/></div>";
                html += "<div class='mt-1'>Годы жизни";
                html += "<div class='row'>";
                html += "<div class='col-6 mt-1'><input type='text' id='p" + i + "b' class='pi form-control' value='" + pi.Birth + "'/></div>";
                html += "<div class='col-6 mt-1'><input type='text' id='p" + i + "d' class='pi form-control' value='" + pi.Dead + "'/></div>";
                html += "</div>";
                html += "</div>";
                html += "</div>";
            }
            html += "<div class='mt-2'>Эпитафия<textarea id='epitaph' rows='6' class='pi form-control'>" + template.Epitaph + "</textarea></div>";

            $("#pEditorPersons").html(html);
            // on change fields with class pi call Draw Editor
            $(".pi").on("input",
                function() {
                    for (var i = 0; i < template.PersonInfos.length; i++) {
                        var pi = template.PersonInfos[i];
                        pi.F = $("#p" + i + "f").val();
                        pi.I = $("#p" + i + "i").val();
                        pi.O = $("#p" + i + "o").val();
                        pi.Birth = $("#p" + i + "b").val();
                        pi.Dead = $("#p" + i + "d").val();
                    }
                    template.Epitaph = $("#epitaph").val();
                    Draw(template);
                });


        }

        function Draw(m) {
            var html = "";

            var template = structuredClone(m.Template);
            FillTemplate(template, m.PersonInfos, m.Epitaph);
            template.Portraits.forEach(function(o, i) {
                html += AddLayer(o, "<img src='" + GetURL(o.ImageId) + "' class='Portrait'>");
            });

            template.Texts.forEach(function(o, i) {
                html += AddLayer(o, "<div style='text-align:" + o.AlignStr + "; font-size:" + GetPx(o.Size) + "; " + (o.Bold ? "font-weight:bold" : "") + "'>" + o.Text + "</div>");
            });


            html += "<div><img src=\"" + GetURL(template.BgImageId) + "\" id=\"imgBack\" style=\"width: 100%; z-index: 0\" /></div>";
            $("#pMain").html(html);
        }

        function FillTemplate(t, pis, epitaph) {
            for (var i = 0; i < pis.length; i++) {
                var pi = pis[i];
                t.Portraits[i].ImageId = pi.ImageId;
                for (var j = 0; j < t.Texts.length; j++) {
                    var ttx = t.Texts[j];
                    console.log(ttx.Text);
                    ttx.Text = ttx.Text.replace("{фамилия" + (i + 1) + "}", pi.F);
                    ttx.Text = ttx.Text.replace("{имя" + (i + 1) + "}", pi.I);
                    ttx.Text = ttx.Text.replace("{отчество" + (i + 1) + "}", pi.O);
                    ttx.Text = ttx.Text.replace("{датар" + (i + 1) + "}", pi.Birth);
                    ttx.Text = ttx.Text.replace("{датас" + (i + 1) + "}", pi.Dead);
                    ttx.Text = ttx.Text.replace("{эпитафия}", epitaph.replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>").replace('\n', "<br/>"));
                    console.log(ttx.Text);
                }
            }
        }

        function GetURL(id) { return "/Images/GetImage/" + id; };

        function GetPx(i) { return px * i + "px" }

        function AddLayer(subj, html) {

            return "<div id='Layer" + subj.Num + "' style='z-index: " + subj.Num + ";width:" + GetPx(subj.Area.W) + "; margin-left:" + GetPx(subj.Area.X) + "; margin-top:" + GetPx(subj.Area.Y) + "'  class='Layer'>" + html + "</div>";
        };


    </script>
}
