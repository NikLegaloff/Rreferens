@using Danik.WebUI.Code.ORM
@model Danik.WebUI.Code.Domain.Template
@{
    ViewData["Title"] = "Home page";
}

<style>
    .layer {
        transform: translate(-50%,-50%);
        position: absolute;
    }
</style>
<div class="row">
    <div class="col-md-8">
        <div id="pMain">
            
            <div id="pMain" style="position: absolute; z-index: -1; overflow: hidden"><img style="filter: grayscale(100%);transform: translateX(-50%);" id="imgMain" src="~/img/1.png" /></div>
            
        </div>
    </div>

    <div class="col-md-4">

        <div class="mb-2"><input type="submit" class="btn btn-sm btn-primary w-100" value="OK" /></div>
    </div>

</div>



@section Scripts
{
    <script>
        var px = 0;
        var model = @Html.Raw(Model.ToJsonMin());

        $(document).ready(function() {
            Init();
            Draw(model);
        });

        function Draw(m) {
            var html = "";

            html += "<div><img src=\"/img/TV.png\" id=\"imgBack\" style=\"width: 100%; z-index: 0\" /></div>";
            $("#pMain").html(html);
        }

        function Init() {
            px = document.getElementById("pMain").clientWidth / 1000;
        }

    </script>
}
