@using Danik.WebUI.Code
@using Danik.WebUI.Code.Domain
@using Danik.WebUI.Code.ORM
@model Danik.WebUI.Code.Domain.Order
@{
    ViewData["Title"] = "Home page";
    var epp = Registry.Current.Epitaphs.SelectAll().Where(e=>e.IsOkFor(Model)).ToArray();
    int i = 0;
    var allImages = Registry.Current.Images.SelectAll();
    var vImages = allImages.Where(im => im.Folder == ImageFolder.Клипарт_верт).Select(im => im.URL).ToArray();
    var hImages = allImages.Where(im => im.Folder == ImageFolder.Клипарт_гориз).Select(im => im.URL).ToArray();
}

<style>
    
</style>
<div class="row ">
    <div class="col-md-6 order-2  order-md-1 mt-2">
        <div id="pEditorPersons">

        </div>
        <div class="row mt-4">
            <div class="col-4"><a class="btn btn-secondary  w-100" href="/Wiz/Step1/@Model.Id">Назад</a></div>
            <div class="col-8"><a class="btn btn-primary w-100" href="javascript:Save()">Дальше</a></div>
        </div>
    </div>

    <div class="col-md-6 order-1 order-md-2 mt-2 ">
        <div id="pMain">

        </div>
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Нажмите на эпитафию</h1>
                <button type="button" id="btnCloseSF" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @foreach(var e in epp)
                {
                    <div class="mt-1">
                        <pre id="ep@i" style="cursor: pointer;" class="text-primary"  onclick="SetEp($(this).text())">@Html.Raw(e.Text)</pre>
                    </div>
                    i++;
                }
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>

        var template = @Html.Raw(Model.TemplateData.ToJsonJS());
        var orderId = '@Html.Raw(Model.Id)';
        var singleEpitaph = @Html.Raw(Model.TemplateData.Template.SingleEpitaph.ToString().ToLower());
        var curEp = "";

        const vImages = @(Html.Raw(vImages.ToJsonJS()));
        const hImages = @(Html.Raw(hImages.ToJsonJS()));

        $(document).ready(function() {
            Init();
        });

        function SetEp(txt) {
            $("#epitaph" + curEp).val(txt);
            if (curEp === "") template.Epitaph = txt;
            else {
                template.PersonInfos[curEp*1].Epitaph = txt;
            }
            Draw(template);
            $("#btnCloseSF").click();
        }

        function Init() {
            DrawEditor();
            Draw(template);
            $(window).on("resize", function() { Draw(template); });
        }

        function Save() {
            // save template to server to /Wiz/Step4Save

            $.ajax({
                type: "POST",
                url: "/Wiz/Step4Save",
                data: { id: orderId, json: JSON.stringify(template) },
                success: function(response) {
                    window.location = "/Wiz/Step5/" + orderId;
                },
                error: function(xhr, status, error) {
                    alert("Ошибка сохранения данных");
                }
            });

        }

        
        function DrawEditor() {
            var html = "";
            
            var images = template.Template.Images;
            if (images.length > 0) {
                html += "<div class='row mb-1'>";
                for (var j = 0; j < images.length; j++) {
                    html += "<div class='col-md-6 col-xl-4'><div id='ImageSelect" + j + "'></div></div>";
                }
                html += "</div>";

            }

            for (var i = 0; i < template.PersonInfos.length; i++) {
                var pi = template.PersonInfos[i];
                html += "<div class='mb-3' id='person" + i + "'>";
                                html += "<div class='mt-1'><input placeholder='Фамилия' type='text' id='p" + i + "f' class='pi form-control' value='" + pi.F.toUpperCase() + "'/></div>";
                html += "<div class='row'>";
                    html += "<div class='mt-1 col'><input placeholder='Имя' type='text' id='p" + i + "i' class='pi form-control' value='" + pi.I + "'/></div>";
                    html += "<div class='mt-1 col'><input placeholder='Отчество' type='text' id='p" + i + "o' class='pi form-control' value='" + pi.O + "'/></div>";
                html += "</div>";
                html += "<div class='mt-1'>";
                html += "<div class='row'>";
                // Use date-mask class, placeholder and pattern to enforce DD/MM/YYYY
                html += "<div class='col mt-1'><input type='text' id='p" + i + "b' class='pi date-mask form-control' placeholder='Дата рождения' maxlength='10' pattern='\\d{2}/\\d{2}/\\d{4}' value='" + pi.Birth + "'/></div>";
                html += "<div class='col mt-1'><input type='text' id='p" + i + "d' class='pi date-mask form-control' placeholder='Дата смерти' maxlength='10' pattern='\\d{2}/\\d{2}/\\d{4}' value='" + pi.Dead + "'/></div>";
                
                if (!singleEpitaph) {
                    html += "<div class='mt-3'>Эпитафия &nbsp;  <button type=\"button\" class=\"btn btn-sm text-primary float-end btn-link\" data-bs-toggle=\"modal\"  onclick='curEp=" + i +"' data-bs-target=\"#exampleModal\">\r\nВыберите эпитафию</button>";
                            html += "<textarea id='epitaph" + i + "' rows='3' class='pi form-control'>" + pi.Epitaph + "</textarea></div>";
                }

                html += "</div>";
                html += "</div>";
                html += "</div>";
            }
            if (singleEpitaph) {
                html += "<div class='mt-3'>Эпитафия &nbsp;  <button type=\"button\" class=\"btn btn-sm text-primary float-end btn-link\" data-bs-toggle=\"modal\" data-bs-target=\"#exampleModal\">\r\nВыберите эпитафию</button>";
                html += "<textarea id='epitaph' rows='3' class='pi form-control'>" + template.Epitaph + "</textarea></div>";
            }


            $("#pEditorPersons").html(html);

            for (var j = 0; j < images.length; j++) {
                var img = images[j];

                    $("#ImageSelect" + j).imageSelector(
                    img.IsVert ? vImages : hImages, {
                    selectedUrl: "/Images/GetImage/" + images[j].ImageId,
                    onImageSelected: function(index, url, id) {
                        imgSelected(url, id.replace("ImageSelect","")*1);
                    }
                });
            }


            // on change fields with class pi call Draw Editor
            $(".pi").on("input",
                function() {
                    for (var i = 0; i < template.PersonInfos.length; i++) {
                        var pi = template.PersonInfos[i];
                        pi.F = $("#p" + i + "f").val();
                        pi.I = $("#p" + i + "i").val();
                        pi.O = $("#p" + i + "o").val();
                        pi.Birth = $("#p" + i + "b").val();
                        pi.Dead = $("#p" + i + "d").val();
                        pi.Epitaph = $("#epitaph" + i).val();
                    }
                    template.Epitaph = $("#epitaph").val();
                    Draw(template);
                });

            // attach mask and validation for date inputs
            function applyDateMask(el) {
                // on input, allow only digits and insert slashes after DD and MM
                el.on('input', function () {
                    var v = $(this).val();
                    // keep digits only
                    var digits = v.replace(/\D/g, '').slice(0,8);
                    var out = '';
                    if (digits.length >= 2) {
                        out += digits.substr(0,2);
                        if (digits.length >= 3) {
                            out += '/'+digits.substr(2,2);
                            if (digits.length > 4) {
                                out += '/'+digits.substr(4);
                            }
                        }
                    } else {
                        out = digits;
                    }
                    $(this).val(out);
                    // simple live validation class
                    var re = /^\d{2}\/\d{2}\/\d{4}$/;
                    if (out.length === 10 && !re.test(out)) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                // on blur, validate full pattern
                el.on('blur', function () {
                    var re = /^\d{2}\/\d{2}\/\d{4}$/;
                    if ($(this).val().length === 0) { $(this).removeClass('is-invalid'); return; }
                    if (!re.test($(this).val())) $(this).addClass('is-invalid'); else $(this).removeClass('is-invalid');
                });
            }

            // apply to each date-mask element
            $(".date-mask").each(function() { applyDateMask($(this)); });
        }

            
            function imgSelected(url, num) {
                console.log(num);
                template.Template.Images[num].ImageId = url.split('/').pop();
                Draw(template);
            }
// COMMON CODE

        (function ($) {
            $.fn.imageSelector = function (images, options = {}) {
                const settings = $.extend({
                    selectedUrl: null,        // начальная картинка
                    onImageSelected: null     // callback(index, imageUrl)
                }, options);

                return this.each(function () {
                    const $container = $(this);
                    let currentIndex = 0;

                    // если передан selectedUrl — ищем индекс этой картинки
                    if (settings.selectedUrl) {
                        const foundIndex = images.indexOf(settings.selectedUrl);
                        if (foundIndex !== -1) {
                            currentIndex = foundIndex;
                        }
                    }

                    // HTML шаблон
                    const widget = $(`
                <div class="image-selector-widget">
                  <div class="controls">
                        <button class="btn btn-outline-secondary prev"><i class='fa fa-arrow-left'></i></button>

                    <div class="dropdown">
                      <button class="btn btn-secondary dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" style='background-color:#000;'>
                        <img src="${images[currentIndex]}" alt="preview">
                      </button>
                      <ul class="dropdown-menu"></ul>
                    </div>
                        
                        <button class="btn btn-outline-secondary next"><i class='fa fa-arrow-right'></i></button>
                  </div>
                </div>
              `);

                    $container.html(widget);

                    const $dropdownMenu = $container.find(".dropdown-menu");
                    const $dropdownButton = $container.find(".dropdown-toggle");

                    // Заполняем список миниатюр
                    images.forEach((img, i) => {
                        const $item = $(`
                  <li>
                    <a class="dropdown-item" href="#" data-index="${i}">
                      <img src="${img}" alt="thumb">
                    </a>
                  </li>
                `);
                        $dropdownMenu.append($item);
                    });

                    function updateImage(index) {
                        currentIndex = index;
                        $dropdownButton.find("img").attr("src", images[index]);
                        // Вызов колбэка при выборе
                        if (typeof settings.onImageSelected === "function") {
                            settings.onImageSelected(index, images[index],$container[0].id);
                        }
                    }

                    // Обработчики
                    $dropdownMenu.on("click", ".dropdown-item", function (e) {
                        e.preventDefault();
                        const index = parseInt($(this).data("index"));
                        updateImage(index);
                    });

                    $container.find(".prev").on("click", function () {
                        currentIndex = (currentIndex - 1 + images.length) % images.length;
                        updateImage(currentIndex);
                    });

                    $container.find(".next").on("click", function () {
                        currentIndex = (currentIndex + 1) % images.length;
                        updateImage(currentIndex);
                    });

                    // Вызов события сразу при инициализации (если selectedUrl задан)
                    //if (typeof settings.onImageSelected === "function") { settings.onImageSelected(currentIndex, images[currentIndex]); }
                });
            };
        })(jQuery);


    </script>
}
