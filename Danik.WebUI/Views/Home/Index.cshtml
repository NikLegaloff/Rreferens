@model StartPageModel
@{
    ViewData["Title"] = "Home page";
    int i = 0;
}


<div class="my-2">

    <!-- Галерея работ -->
    <section id="gallery" class="mb-5">
        
        <div class="position-relative">


        <!-- Контейнер с фото -->
        <div class="gallery-container d-flex overflow-auto px-2" style="scroll-behavior: smooth;">
            @foreach (var g in Model.Images)
            {
                <img id="img@(i)" src="@g.URL" class="img-fluid rounded m-2 shadow-sm" style="max-height: 50vh;">
                i++;
            }
        </div>

        </div>

    </section>
    <section id="orderLink" class="text-center mb-5">
        <a href="/Wiz/Step1/" class="btn btn-success btn-lg px-5 py-3 fs-4 shadow">
            Перейти к оформлению заказа
        </a>
    </section>


    <div class="row">

    <!-- Информация о доставке -->
    <section id="delivery" class="mb-5 col-xxl-4 col-xl-6">
        <h2 class="text-center mb-3">Доставка</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0">
                    Мы осуществляем доставку памятников по всему региону.
                    Доставка по городу — <strong>бесплатно</strong>, за пределы — по индивидуальному тарифу.
                    Возможен монтаж на месте нашими специалистами.
                </p>
            </div>
        </div>
    </section>

    <!-- Сроки изготовления -->
        <section id="timing" class="mb-5 col-xxl-4 col-xl-6">
        <h2 class="text-center mb-3">Сроки изготовления</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Стандартные модели — от <strong>7 до 14 дней</strong></li>
                    <li class="list-group-item">Индивидуальные заказы — до <strong>30 дней</strong></li>
                    <li class="list-group-item">Срочное изготовление — по договорённости</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Контактная информация -->
        <section id="contacts" class="mb-5 col-xxl-4 col-xl-6">
        <h2 class="text-center mb-3">Контакты</h2>
        <div class="justify-content-center">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <p><strong>Адрес:</strong> г. Москва, ул. Примерная, д. 10</p>
                        <p><strong>Телефон:</strong> <a href="tel:+74951234567">+7 (495) 123-45-67</a></p>
                        <p><strong>Email:</strong> <a href="mailto:info@pamyatnik.ru">info@pamyatnik.ru</a></p>
                        <p>
                            <strong>Режим работы:</strong><br>
                            Пн–Сб: 9:00–19:00<br>
                            Вс: по предварительной записи
                        </p>
                    </div>
                </div>
        </div>
    </section>
    </div>

    <!-- Кнопка оформления заказа -->
    <section id="orderLink" class="text-center mb-5">
        <a href="/Wiz/Step1/" class="btn btn-success btn-lg px-5 py-3 fs-4 shadow">
            Перейти к оформлению заказа
        </a>
    </section>
</div>



@section Scripts
{
    <script>
        var img = document.querySelector('img');

        if (img.complete) {
            loaded();
        } else {
            img.addEventListener('load', loaded);
            img.addEventListener('error',
                function() {
                    alert('error');
                });
        }
        function loaded() {
            const $gallery = $('.gallery-container');
            var scrollStep = document.getElementById("img0").clientWidth; // пикселей за шаг
            let autoScrollInterval;

            const myDiv = document.getElementById('img0');

            // Width including content, padding, and border
            const offsetWidth = myDiv.offsetWidth;

            // Get computed style for margins
            const computedStyle = window.getComputedStyle(myDiv);
            const marginLeft = parseFloat(computedStyle.marginLeft);
            const marginRight = parseFloat(computedStyle.marginRight);

            // Total width including margins
            scrollStep = offsetWidth + marginLeft + marginRight;

            // Ручной скролл кнопками
            $('.gallery-next').on('click', function() {
                $gallery.animate({ scrollLeft: '+=' + scrollStep }, 400);
            });
            $('.gallery-prev').on('click', function() {
                $gallery.animate({ scrollLeft: '-=' + scrollStep }, 400);
            });

            // Автоматическая прокрутка каждые 5 секунд
            function startAutoScroll() {
                autoScrollInterval = setInterval(() => {
                    const maxScroll = $gallery[0].scrollWidth - $gallery.outerWidth();
                    let newPos = $gallery.scrollLeft() + scrollStep;
                    if (newPos >= maxScroll) newPos = 0; // Возврат в начало
                    $gallery.animate({ scrollLeft: newPos }, 800);
                }, 5000);
            }

            function stopAutoScroll() {
                clearInterval(autoScrollInterval);
            }

            // Запуск автоскролла
            startAutoScroll();

            // При наведении — пауза, при уходе — продолжить
            $gallery.on('mouseenter', stopAutoScroll);
            $gallery.on('mouseleave', startAutoScroll);
        }
    </script>
}
