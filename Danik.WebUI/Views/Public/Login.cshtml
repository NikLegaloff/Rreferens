@{
    ViewData["Title"] = "Login";

}
@using (Html.BeginForm("Login", "Public"))
{

    <div class="row mt-4 justify-content-center">
        <div class="col-sm-4">
            <input type="email" autofocus name="email" placeholder="Email" class="form-control form-control-lg" />
            <input type="password" name="password" placeholder="Password" class="form-control form-control-lg mt-4"/>
            <div class="mt-3">
                <input type="submit" value="LOGIN" class="btn btn-primary btn-lg w-100"/>
            </div>
        </div>
    </div>
}