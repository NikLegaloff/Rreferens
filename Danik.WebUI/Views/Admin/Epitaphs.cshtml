@using Danik.WebUI.Code.Domain
@model Epitaph[]
@{
    ViewData["Title"] = "Эпитафии";
}

<style>
    </style>
<h4>Эпитафии</h4>
    <div class="row">
        <div class="col-md-6">
            @if (Model.Length > 0)
            {
                foreach (var epitaph in Model)
                {
                    <div class="">
                        
                        <div class="row">
                            <div class="col">@(epitaph.Persons == null ? "" : ("Для " + (epitaph.Persons == 1 ? "одного" : "нескольких")))</div>
                            <div class="col">@(epitaph.Lang)</div>
                            <div class="col text-end">
                                <a href="/Admin/EpitaphDelete/@epitaph.Id" onclick="return confirm('Ущдалить?')" class="text-danger"><i class="fa fa-tiems"></i> Удалить</a>
                            </div>
                        </div>
                    <pre>@epitaph.Text</pre>
                        <hr />
                    </div>
                }
            }
            
        </div>
            <div class="col-md-4">    
                @using (Html.BeginForm("EpitaphAdd", "Admin", FormMethod.Post))
                {
                    <div class=" row mb-2">
                        <div class="col">
                            <select name="Persons" class="form-select">
                                <!option value="">Универсальная</!option>
                                <!option value="1">Для одного</!option>
                                <!option value="2">Для нескольких</!option>
                            </select>
                        </div>
                        <div class="col">
                         <select name="lang" class="form-select">
                                <!option value="0">Ru</!option>
                                <!option value="1">Ro</!option>
                            </select>

                        </div>
                    </div>
                    <textarea required class="form-control" rows="8" name="text"></textarea>
                    <div class="mt-2"><input type="submit" value="Добавить" class="btn btn-primary"/></div>
                }

        </div>          
    </div>
    @section Scripts
{
    <script>
    </script>
}
