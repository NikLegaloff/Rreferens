@using Danik.WebUI.Code
@using Danik.WebUI.Code.Domain
@model User
@{
    ViewData["Title"] = "UserEdit";
    
}

<style>
</style>
<!-- Edit user form-->
<div class="my-5 row">
    
    @using (Html.BeginForm("SaveUser", "Admin", FormMethod.Post))
    {
        <div class="col-md-6">
            @Html.HiddenFor(m => m.Id)
            <div class="mb-3 row">
                <label for="Email" class="col-sm-2 col-form-label">Email</label>
                <div class="col-sm-10">
                    @Html.TextBox("Email", "", new { @class = "form-control", id = "Email", required = "required", type = "Email" })
                </div>
            </div>
            <div class="mb-3 row">
                <label for="Name" class="col-sm-2 col-form-label">Имя</label>
                <div class="col-sm-10">
                    @Html.TextBox("Name", "", new { @class = "form-control", id = "Name", required = "required" })
                </div>
            </div>
            <div class="mb-3 row">
                <label for="pass" class="col-sm-2 col-form-label">Пароль</label>
                <div class="col-sm-10">
                    <input type="text" id="pass" class="form-control" name="password" @(Model.Id == Guid.Empty ? "required" : "")/>
                </div>
            </div>

            <div class="mb-3 row">
                <label for="PartnerId" class="col-sm-2 col-form-label">Партнёр</label>
                <div class="col-sm-10">
                    <select name="PartnerId" id="PartnerId" class="form-select">
                        @foreach (var p in Registry.Current.Partners.SelectAll())
                        {
                            <!option value="@p.Id" @(p.Id == Model.Id ? "selected" : "")>@p.Name</!option>
                        }
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-sm-10 offset-sm-2">
                    <input type="submit" class="btn btn-primary" value="Сохранить"/>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts
{
    <script>
    </script>
}
