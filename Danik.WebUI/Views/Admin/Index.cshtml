@using Danik.WebUI.Code
@using Danik.WebUI.Code.Domain
@model OrdersList
@{
    ViewData["Title"] = "Home page";
}

<style>

    </style>
@using (Html.BeginForm("Index", "Admin", FormMethod.Get))
{
    <div class="alert alert-light" role="alert">
        <div class="row">
            <div class="col-auto mb-2">
                <input type="text" placeholder="№ заказа, телефон, почта или имя" value="@Model.Q" name="q" class="form-control w-100"/>
            </div>
            <div class="col-auto mb-2">
                <select name="status" class="form-select">
                    <!option value="" @(Model.Status == null ? "selected" : "") >Все статусы</!option>
                    @foreach (var s in Enum.GetNames(typeof(OrderStatus)))
                    {
                        var st = Enum.Parse<OrderStatus>(s);
                        <!option @(Model.Status == st? "selected":"") value="@((int)st)">@st</!option>
                    }
                </select>
            </div>
            <div class="col-auto mb-2">
                <select name="PartnerId" class="form-select">
                    <!option value="">Любой партнёр</!option>
                    @foreach (var p in Registry.Current.Partners.SelectAll())
                    {
                        <!option @(Model.PartnerId == p.Id ? "selected" : "") value="@(p.Id)">@p.Name</!option>
                    }
                </select>
            </div>
            <div class="col-auto mb-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fa fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
}
<table class="table">
    <tr>
        <th>№, дата</th>
        @if (Model.PartnerId == null)
        {
            <th>Партнёр</th>
        }
        
        @if (Model.Status == null)
        {
            <th>Статус</th>
        }
        
        <th>Детали</th>
        <th class="d-none d-md-block">Контакт</th>
        <th></th>
    </tr>
    @foreach (var order in Model.Orders)
    {
        <tr>
            <td>
                <b>№@order.Number</b>
                <div>@order.Date.ToString("dd.MM.yyyy HH:mm")</div>
            </td>
            @if (Model.PartnerId == null)
            {
                <td>@Registry.Current.Partners.Find(order.PartnerId).Name</td>
            }
            @if (Model.Status == null)
            {
                <td>@order.Status</td>
            }
            
            
            <td>
                @order.Type @("x" + order.Persons)
                <div class="fst-italic">@order.Comment</div>
            </td>
            <td class="d-none d-md-block">
                @order.Contact?.Name @order.Contact?.Phone
                <br>@order.Contact?.Email @Html.Raw("&nbsp;")
            </td>
            <td class="text-end">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton-@order.Id" data-bs-toggle="dropdown" aria-expanded="false">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton-@order.Id">
                        <li><a class="dropdown-item" href="/Admin/OrderView/@order.Id"><i class="fa-solid fa-magnifying-glass me-2"></i>Просмотр</a></li>
                        <li><a class="dropdown-item" href="/Wiz/Step1/@order.Id"><i class="fa fa-edit me-2"></i>Редактировать</a></li>
                        <li><a class="dropdown-item" href="/Wiz/Step4/@order.Id"><i class="fa fa-user me-2"></i>Редактировать макет</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        @if (order.Status == OrderStatus.Создан)
                        {
                            <li><a class="dropdown-item text-success" href="/Admin/OrderSetStatus/@order.Id?status=2"><i class="fa fa-arrow-right me-2"></i>Оплачен</a></li>
                            <li><a class="dropdown-item text-warning" href="/Admin/OrderSetStatus/@order.Id?status=4"><i class="fa fa-arrow-right me-2"></i>Отменить</a></li>
                        }
                        @if (order.Status == OrderStatus.Оплачен)
                        {
                            <li><a class="dropdown-item" href="/Admin/OrderSetStatus/@order.Id?status=3"><i class="fa fa-arrow-right me-2"></i>Завершить</a></li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" onclick="return confirm('Удалить заказ? Действие нельзя будет отменить')" href="/Admin/OrderDelete/@order.Id"><i class="fa fa-times me-2"></i>Удалить</a></li>
                    </ul>
                </div>
            </td>
        </tr>
    }
</table>

@section Scripts
{
    <script>
    </script>
}
