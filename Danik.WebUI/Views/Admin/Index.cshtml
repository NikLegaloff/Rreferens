@using Danik.WebUI.Code.Domain
@model OrdersList
@{
    ViewData["Title"] = "Home page";
}

<style>

    </style>
@using (Html.BeginForm("Index", "Admin", FormMethod.Get))
{


    <div class="alert alert-light" role="alert">
        <div class="row">
            <div class="col-6">
                <input type="text" placeholder="№ заказа, телефон, почта или имя" value="@Model.Q" name="q" class="form-control w-100"/>
            </div>
            <div class="col">
                <select name="status" class="form-select">
                    <!option value="">Все статусы</!option>
                    <!option @(Model.Status == OrderStatus.Создаётся? "selected":"") value="0">Создаётся</!option>
                    <!option @(Model.Status == OrderStatus.Создан ? "selected" : "")  value="1">Создан</!option>
                    <!option @(Model.Status == OrderStatus.В_рвботе ? "selected" : "")  value="2">В рвботе</!option>
                    <!option @(Model.Status == OrderStatus.Завершён ? "selected" : "")  value="3">Завершён</!option>
                    <!option @(Model.Status == OrderStatus.Отменён ? "selected" : "")  value="4">Отменён</!option>
                </select>
            </div>
            <div class="col">
                <input type="submit" value="Показать" class="btn btn-primary w-100"/>
            </div>
        </div>
    </div>
}
<table class="table">
    <tr>
        <th>№, дата</th>
        <th>Статус</th>
        <th>Детали</th>
        <th>Контакт</th>
        <th></th>
    </tr>
    @foreach (var order in Model.Orders)
    {
        <tr>
            <td>
                <b>№@order.Number</b>
                <div>@order.Date.ToString("dd.MM.yyyy HH:mm")</div>
            </td>
            <td>@order.Status</td>
            <td>
                @("x" + order.Persons) @order.Type.ToString().Substring(0,4) @order.Options.SizeStr
                <div>@(order.PersonInfos==null ? "Нет": order.PersonInfos.Length)  фото</div>
            </td>
            <td>
                @order.ContactName @order.Phone<br />
                @order.Email
            </td>
            <td>
                <a class="btn btn-primary" href="/Admin/OrderView/@order.Id"><i class="fa-solid fa-magnifying-glass"></i></a>
            <a  class="btn btn-primary" href="/Wiz/Step1/@order.Id"><i class="fa fa-edit"></i></a>
        </tr>
    }
</table>

@section Scripts
{
    <script>
    </script>
}
