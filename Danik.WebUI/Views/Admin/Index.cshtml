@using Danik.WebUI.Code.Domain
@model Danik.WebUI.Code.Domain.Order[]
@{
    ViewData["Title"] = "Home page";
}

<style>

</style>

<table class="table">
    <tr>
        <th>№, дата</th>
        <th>Статус</th>
        <th>Детали</th>
        <th>Контакт</th>
        <th></th>
    </tr>
    @foreach (var order in Model)
    {
        <tr>
            <td>
                <b>№@order.Number</b>
                <div>@order.Date.ToString("dd.MM.yyyy HH:mm")</div>
            </td>
            <td>@order.Status</td>
            <td>
                @order.Persons чел, @order.Type, @order.Options.SizeStr
                <div>@(order.PersonInfos==null ? "Нет": order.PersonInfos.Length)  фото</div>
            </td>
            <td>
                @order.ContactName @order.Phone<br />
                @order.Email
            </td>
            <td>
            <a  class="btn btn-primary" href="/Admin/OrderView/@order.Id">Посмотреть</a>
            <a  class="btn btn-primary" href="/Wiz/Step1/@order.Id">Редактировать</a>
        </tr>
    }
</table>

@section Scripts
{
    <script>
    </script>
}
