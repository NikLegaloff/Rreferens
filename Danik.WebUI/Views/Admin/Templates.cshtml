@using Danik.WebUI.Code
@using Danik.WebUI.Code.Domain
@model Template[]
@{
    ViewData["Title"] = "Шаблоны";
}

<style>

    </style>
@using (Html.BeginForm("TemplateCreate", "Admin", FormMethod.Get))
{
    <div class="alert alert-light" role="alert">
        <div class="row">
            <div class="col-auto">
                <select name="type" class="form-select">
                    //StoneTypes enum
                    @foreach (var s in Enum.GetNames(typeof(StoneType)))
                    {
                        var st = Enum.Parse<StoneType>(s);
                        <!option value="@((int)st)">@st</!option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="persons" class="form-select">
                    <!option value="1">1</!option>
                    <!option value="2">2</!option>
                    <!option value="3">3</!option>
                </select>
            </div>
            <div class="col-auto">
                <input type="submit" value="Создать/редактировать" class="btn btn-primary"/>
            </div>
        </div>
    </div>
}
<table class="table w-auto">
    <tr>
        <th></th>
        <th>Тип</th>
        <th>Кол-во</th>
        <th></th>
    </tr>
    @foreach (var template in Model)
    {
        
        
        <tr>
            <td><img src="@(Image.GetURL(template.Data.BgImageId))" style="max-height: 40px;" /></td>
            <td>@template.Type</td>
            <td>@template.Persons</td>
            <td class="text-end">
            <a class="btn btn-sm btn-primary mt-1" href="/Admin/TemplateEdit/@template.Id"><i class="fa-solid fa-edit"></i> Редактировать</a>
        </tr>
    }
</table>

@section Scripts
{
    <script>
    </script>
}
