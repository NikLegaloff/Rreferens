@using Danik.WebUI.Code
@using Danik.WebUI.Code.Domain
@model Danik.WebUI.Code.Domain.Order
@{
    ViewData["Title"] = "Просмотр заказа";
}

<a href="/Admin/">Назад к заказам</a>

<div class="row">
    <div class="col-xxl-5 col-xl-6 col-lg-8 col-md-10">

        <div class="row">
            <div class="col-4">
                <label>Номер заказа:</label>
                <input type="text" value="@Model.Number" readonly class="form-control" />
            </div>
            <div class="col-4">
                <label>Статус:</label>
                <input type="text" value="@Model.Status" readonly class="form-control" />
            </div>
            <div class="col-4">
                <label>Дата:</label>
                <input type="text" value="@Model.Date.ToString()" readonly class="form-control" />
            </div>
        </div>

        <h4 class="mt-3">Камень</h4>
        <div class="row">
            <div class="col">
                <label>Тип:</label>
                <input type="text" value="@Model.Type" readonly class="form-control" />
            </div>
            <div class="col">
                <label>Кол-во:</label>
                <input type="text" value="@Model.Persons" readonly class="form-control" />
            </div>
            <div class="col">
                <label>Размер:</label>
                <input type="text" value="@Model.Options?.SizeStr" readonly class="form-control" />
            </div>
        </div>


        <div class="row">
            <div class="col">
                <label>Толщина:</label>
                <input type="text" value="@Model.Options?.Depth" readonly class="form-control" />
            </div>
            <div class="col">
                <label>Свой размер:</label>
                <input type="text" value="@Model.Options?.OwnSize" readonly class="form-control" />
            </div>
        </div>
        @if (Model.StoneForm != null)
        {
            var sf = Registry.Current.StoneForms.Find((Guid)Model.StoneForm);
            var sfi = Registry.Current.Images.Find(sf.ImageId);
            <div class="mt-2">
                <label>Форма камня:</label><br />
                <a target="_blank" href="@sfi.URL"><img src="@sfi.TMB" /></a>
            </div>
        }
        <h4 class="mt-3">Конакты</h4>
        <div class="row">
            <div class="col">
                <label>Телефон:</label>
                <input type="text" value="@Model.Contact?.Phone" readonly class="form-control" />
            </div>
            <div class="col">
                <label>Email:</label>
                <input type="text" value="@Model.Contact?.Email" readonly class="form-control" />
            </div>
            <div class="col">
                <label>Имя:</label>
                <input type="text" value="@Model.Contact?.Name" readonly class="form-control" />
            </div>
        </div>
        <div>
            <label>Комментарий:</label>
            <textarea readonly class="form-control">@Model.Comment</textarea>
        </div>

    </div>
</div>

<div class="mt-3">
    <h4>Персоны</h4>
    @if (Model.TemplateData.PersonInfos != null && Model.TemplateData.PersonInfos.Length > 0)
    {
        <table class="table">
            <thead>
            <tr>
                <th>Фото</th>
                <th>ФИО</th>
                <th>Даты</th>
                <th>Комментарий</th>
                <th>Эпитафия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.TemplateData.PersonInfos)
            {
                var img = Registry.Current.Images.Find(p.ImageId);
                <tr>
                    <td><a href="@img.URL"><img src="@img.TMB"/></a></td>
                    <td>@p.F @p.I @p.O</td>
                    <td>@p.Birth - @p.Dead</td>
                    <td>@p.Comment</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <span>Нет</span>
    }
</div>

<div class="mt-3">
    Эпитафия: <br />
    @Model.TemplateData.Epitaph
</div>
<div class="mt-3">
    <h4>Свои примеры</h4>
    @if (Model.ExampleImages != null && Model.ExampleImages.Length > 0)
    {
        
        @foreach (var img in Model.ExampleImages)
        {
                var i = Registry.Current.Images.Find(img);
            <div><a href="@i.URL"><img src="@i.TMB" /></a></div>
        }
        
    }
    else
    {
        <span>Нет</span>
    }
</div>

@section Scripts
{
    <script>
    </script>
}
