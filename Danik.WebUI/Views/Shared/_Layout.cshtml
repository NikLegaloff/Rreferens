@using Danik.WebUI.Code.Domain
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link href="~/lib/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var user = (User?)ViewData["User"];
}
<body>

<div class="container py-3">
    <header>
        
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                    <a class="navbar-brand" href="/">РЕФЕРЕНС</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" aria-current="page" href="/Wiz/Step1/">Новый заказ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Примеры работ</a>
                        </li>
                        
                    </ul>
                </div>
                @if (user != null)
                {
                    <div class="d-lg-flex  justify-content-lg-end dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-user"></i>  @(user.Email.Split('@')[0])
                        </a>
                        <ul class="dropdown-menu">
                            @if (user.IsAdmin)
                            {
                                <li><a class="dropdown-item" href="/Admin/">Заказы</a></li>
                                <li><a class="dropdown-item" href="/Admin/Gallery/">Галерея</a></li>
                                <li><a class="dropdown-item" href="/Admin/Templates/">Шаблоны</a></li>
                                    <li><a class="dropdown-item" href="/Admin/Epitaphs/">Эпитафии</a></li>
                                    <li><a class="dropdown-item" href="/Admin/Partner/">Партнёры</a></li>
                                <li><a class="dropdown-item" href="/Admin/TemplateBgImage/">Фоны шаблонов</a></li>
                            }
                            <li><a class="dropdown-item" href="/Partner/">Галерея работ</a></li>
                                <li><a class="dropdown-item" href="/User/ChangePassword">Мой аккаунт</a></li>
                            <li><a class="dropdown-item text-danger" href="/Public/Logout/">Выйти</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-lg-flex justify-content-lg-end">
                            <a class="nav-link" href="/Public/Login/">Для партнёров</a>
                    </div>

                }
            </div>
        </nav>


    </header>
    <main>
        @RenderBody()
    </main>
</div>


<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://kit.fontawesome.com/65af487970.js" crossorigin="anonymous"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>